# Copy to .env and adjust:  cp .env.example .env
# NEVER commit .env or real credentials. All values below are examples.

# ---- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---- Safe remediation --------------------------------------------------------
# true  = remediation only ever previews actions (default and recommended)
# false = /api/remediation/execute may change the host (also needs the key below)
DRY_RUN=true
# Required (together with DRY_RUN=false) to call POST /api/remediation/execute.
# Generate one with:  openssl rand -hex 32
REMEDIATION_API_KEY=

# ---- Detection thresholds ----------------------------------------------------
CPU_THRESHOLD=85
MEMORY_THRESHOLD=85
DISK_THRESHOLD=85
# 1-minute load average divided by the number of CPU cores (1.0 = fully busy)
LOAD_THRESHOLD=1.5

# ---- Local diagnostics / cleanup scope --------------------------------------
DISK_PATH=/
# Comma-separated, absolute, dedicated directories. System paths are always refused.
CLEANUP_DIRS=/tmp/cloudops360
CLEANUP_EXTENSIONS=.tmp,.log,.gz,.old
CLEANUP_MIN_AGE_HOURS=24
CLEANUP_MAX_FILES=100
# Services that are monitored and may be restarted (systemd unit names)
ALLOWED_SERVICES=cloudops-demo
# Seconds to wait after a restart before verifying the service is active
RESTART_VERIFY_DELAY_SECONDS=2

# ---- Docker Compose ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally

# ---- AWS (optional) ----------------------------------------------------------
# Leave empty to run without AWS. Prefer a read-only IAM role / SSO profile over keys.
AWS_ENABLED=true
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=cloudops360-readonly
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Azure (optional) --------------------------------------------------------
# Leave empty to run without Azure. Needs a subscription id plus any
# DefaultAzureCredential source (az login, service principal env vars, managed identity).
AZURE_ENABLED=true
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Cloud polling -----------------------------------------------------------
CLOUD_CACHE_TTL_SECONDS=60
# Background refresh interval; 0 disables background polling
CLOUD_REFRESH_SECONDS=60
